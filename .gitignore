*.pptx
*.accdb
*.mdb
*.pub
*.vsd
*.vsdx

# ─── Temporary files ──────────────────────────────────────────────────────────
*.tmp
*~
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Environment files ────────────────────────────────────────────────────────
.env
.env.local
*.env.*

# ─── Python & dependency caches ───────────────────────────────────────────────
.venv/
venv/
__pycache__/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/
cache/

# ─── Test cache (keep tests/ folder and source files) ─────────────────────────
tests/__pycache__/
tests/.pytest_cache/

# ─── Results: keep folder structure, ignore all files ─────────────────────────
# Allow directories (so git tracks the folder skeleton)
results/**/
!results/
!results/csv/
!results/plots/
!results/reports/
!results/frame_selection/
!results/captions/
!results/metadata/
!results/logs/
!results/cache/
# Ignore every file inside any results subdirectory
results/**/*

